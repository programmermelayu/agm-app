# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muktamar_agm_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars_long_change_in_production
JWT_EXPIRY=24h

# Email Configuration (Nodemailer with SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@ethereal.email
SMTP_PASS=your_password
SMTP_FROM=noreply@muktamar.local

# Alternative: Use Gmail SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Redis (for Bull job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL (for RSVP links in emails)
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development
