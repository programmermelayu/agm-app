# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muktamar_agm_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars_long_change_in_production
JWT_EXPIRY=24h

# Email Configuration (SendGrid or Nodemailer)
SENDGRID_API_KEY=your_sendgrid_api_key_or_leave_empty_for_dev
EMAIL_FROM=noreply@muktamar.com

# Redis (for Bull job queue)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Environment
ENVIRONMENT=development
