# Railway Production Environment Variables
# Copy these to Railway dashboard and fill in YOUR values

# ===== AUTOMATIC (Set by Railway) =====
# DATABASE_URL=postgresql://user:password@host:port/database
# REDIS_URL=redis://user:password@host:port

# ===== REQUIRED CONFIGURATION =====

# Server
NODE_ENV=production
PORT=3000
ENVIRONMENT=production

# JWT Authentication
JWT_SECRET=your-super-secure-32-character-string-here-12345678
JWT_EXPIRY=24h

# ===== EMAIL CONFIGURATION (Choose ONE OPTION) =====

# Option A: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Option B: SendGrid SMTP (uncomment if using)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Option C: Custom SMTP Server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Email Settings
SMTP_FROM=noreply@muktamar.com
EMAIL_FROM=noreply@muktamar.com

# ===== FRONTEND & CORS =====

# Frontend URL (where frontend is hosted)
FRONTEND_URL=https://your-frontend-domain.com

# CORS Origin (frontend domain)
CORS_ORIGIN=https://your-frontend-domain.com

# ===== LOGGING =====

LOG_LEVEL=info

# ===== NOTES =====
# 1. Do NOT commit this file with real secrets
# 2. Add .env.railway.example to version control
# 3. Add actual .env.railway to .gitignore
# 4. In Railway dashboard, copy these variables and fill in YOUR values
# 5. Never share JWT_SECRET or email passwords
