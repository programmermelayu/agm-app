{
  "name": "muktamar-agm-frontend",
  "version": "0.1.0",
  "description": "Frontend SPA for Muktamar AGM Management System",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
